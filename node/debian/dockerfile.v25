# Source images are pinned by digest to preserve the selected versions.
FROM node:25-bookworm-slim@sha256:81db02c4b671288a03915da9534dbd54f96d0e7c24d80ccc54f5b36b2e684370 AS runtime

FROM debian:latest@sha256:2dc419c6d7fe3dad0a2f9fd469c34cc90b0f9ba642d8fde837fe3d7d34a0e7f1

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y \
    && apt-get autoremove -y --purge \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates libstdc++6 libatomic1 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY --from=runtime /usr/local/ /usr/local/

RUN test "$(node -p 'process.versions.node.split(".")[0]')" = "25" \
    && node --version \
    && npm --version

WORKDIR /app

CMD ["node", "--help"]
