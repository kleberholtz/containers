# Source images are pinned by digest to preserve the selected versions.
FROM python:3.10-slim-bookworm@sha256:5be5aaecb962a41567bc8041f1e9e3432cb085b037fe057f9a562630b2e4b370 AS runtime

FROM ubuntu:latest@sha256:6a06111c3b0a8600feadb270aec771dc239bf407b25625f93f44ab00e11f4d3c

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y \
    && apt-get autoremove -y --purge \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates build-essential libbz2-dev libexpat1-dev libffi-dev libgdbm-dev liblzma-dev libncurses-dev libreadline-dev libsqlite3-dev libssl-dev uuid-dev zlib1g-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY --from=runtime /usr/local/ /usr/local/
RUN ldconfig
ENV PATH="/usr/local/bin:${PATH}"

RUN python3 -c 'import sys; assert sys.version_info[:2] == (3, 10)' \
    && python3 -m pip --version \
    && python3 -c 'import ssl, sqlite3, bz2, lzma, ctypes, readline, uuid; import venv'

WORKDIR /app

CMD ["python3", "--help"]
