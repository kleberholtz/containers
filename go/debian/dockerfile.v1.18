# Source images are pinned by digest to preserve the selected versions.
FROM golang:1.18@sha256:50c889275d26f816b5314fc99f55425fa76b18fcaf16af255f5d57f09e1f48da AS runtime

FROM debian:latest@sha256:2dc419c6d7fe3dad0a2f9fd469c34cc90b0f9ba642d8fde837fe3d7d34a0e7f1

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y \
    && apt-get autoremove -y --purge \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates build-essential git \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY --from=runtime /usr/local/go/ /usr/local/go/
ENV GOPATH=/go \
    GOTOOLCHAIN=local \
    PATH="/usr/local/go/bin:/go/bin:${PATH}"

RUN go version | grep -E '^go version go1\.18(\.| )' \
    && go version

WORKDIR /app

CMD ["go", "--help"]
