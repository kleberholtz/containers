# Source images are pinned by digest to preserve the selected versions.
FROM golang:1.19@sha256:3025bf670b8363ec9f1b4c4f27348e6d9b7fec607c47e401e40df816853e743a AS runtime

FROM ubuntu:latest@sha256:6a06111c3b0a8600feadb270aec771dc239bf407b25625f93f44ab00e11f4d3c

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y \
    && apt-get autoremove -y --purge \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates build-essential git \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY --from=runtime /usr/local/go/ /usr/local/go/
ENV GOPATH=/go \
    GOTOOLCHAIN=local \
    PATH="/usr/local/go/bin:/go/bin:${PATH}"

RUN go version | grep -E '^go version go1\.19(\.| )' \
    && go version

WORKDIR /app

CMD ["go", "--help"]
