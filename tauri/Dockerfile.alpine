FROM alpine:latest

RUN apk update \
    && apk upgrade --no-cache \
    && apk add --no-cache \
        ca-certificates rust cargo build-base nodejs npm \
        webkit2gtk-4.1-dev curl wget file openssl-dev \
        libayatana-appindicator-dev librsvg-dev xdotool-dev pkgconf font-dejavu \
    && rm -rf /var/cache/apk/*

# Link dynamically against Alpine's system libraries instead of requiring
# static versions of the entire GTK/WebKit dependency tree.
ENV RUSTFLAGS="-C target-feature=-crt-static"

RUN npm install --global '@tauri-apps/cli@^2' \
    && npm cache clean --force

RUN rustc --version \
    && cargo --version \
    && node --version \
    && npm --version \
    && tauri --version \
    && pkg-config --exists webkit2gtk-4.1 gtk+-3.0 openssl

WORKDIR /app

CMD ["tauri", "--help"]
