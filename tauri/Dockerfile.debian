FROM debian:latest

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y \
    && apt-get autoremove -y --purge \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates rustc cargo build-essential nodejs npm \
        libwebkit2gtk-4.1-dev curl wget file libxdo-dev libssl-dev \
        libayatana-appindicator3-dev librsvg2-dev pkg-config \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN npm install --global '@tauri-apps/cli@^2' \
    && npm cache clean --force

RUN rustc --version \
    && cargo --version \
    && node --version \
    && npm --version \
    && tauri --version \
    && pkg-config --exists webkit2gtk-4.1 gtk+-3.0 openssl

WORKDIR /app

CMD ["tauri", "--help"]
