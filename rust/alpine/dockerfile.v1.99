# Source images are pinned by digest to preserve the selected versions.
FROM rust:1.99-alpine@sha256:7e9e2d068a107a2adafd19930011178d14a78326053cd4c3a9f7ad3fd049557d AS runtime

FROM alpine:latest@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a

RUN apk update \
    && apk upgrade --no-cache \
    && apk add --no-cache ca-certificates build-base pkgconf openssl-dev \
    && rm -rf /var/cache/apk/*

COPY --from=runtime /usr/local/cargo/ /usr/local/cargo/
COPY --from=runtime /usr/local/rustup/ /usr/local/rustup/
ENV CARGO_HOME=/usr/local/cargo \
    RUSTUP_HOME=/usr/local/rustup \
    PATH="/usr/local/cargo/bin:${PATH}"
ENV RUSTFLAGS="-C target-feature=-crt-static"

RUN rustc --version | grep -E '^rustc 1\.99\.' \
    && cargo --version

WORKDIR /app

CMD ["cargo", "--help"]
